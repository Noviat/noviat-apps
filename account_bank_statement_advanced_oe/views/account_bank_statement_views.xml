<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_bank_statement_line_tree_bank_rec_widget" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.bank_rec_widget</field>
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_accountant.view_bank_statement_line_tree_bank_rec_widget"
        />
        <field name="arch" type="xml">
            <field name="statement_id" position="attributes">
                <attribute name="context" operation="update">
                    {
                        'form_view_ref': 'account_bank_statement_advanced.account_bank_statement_view_form',
                    }
                </attribute>
            </field>
        </field>
    </record>

    <record
        id="account_accountant.action_bank_statement_line_form_bank_rec_widget"
        model="ir.actions.act_window"
    >
        <field
            name="view_id"
            ref="account_bank_statement_advanced.account_bank_statement_line_view_form"
        />
    </record>

    <record
        id="account_accountant.action_bank_statement_form_bank_rec_widget"
        model="ir.actions.act_window"
    >
        <field
            name="view_id"
            ref="account_bank_statement_advanced.account_bank_statement_view_form"
        />
        <field name="context">{'dialog_size': 'large'}</field>
    </record>
</odoo>
