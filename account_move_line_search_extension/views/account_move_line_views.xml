<?xml version="1.0" encoding="utf-8" ?>
<odoo>

	<record id="view_move_line_tree" model="ir.ui.view">
		<field name="name">account.move.line.amlse</field>
		<field name="model">account.move.line</field>
		<field name="inherit_id" ref="account.view_move_line_tree" />
		<field name="arch" type="xml">
			<xpath expr="//tree" position="attributes">
				<attribute name="js_class">account_move_line_search_extension_list_view</attribute>
			</xpath>
            <field name="sequence" position="after">
                <field name="statement_id" column_invisible="True" />
            </field>
		</field>
	</record>

	<record id="account.action_account_moves_all" model="ir.actions.act_window">
		<field name="view_mode">tree,pivot,graph,kanban,form</field>
        <field
            name="context"
        >{'journal_type':'general', 'search_default_posted':1, 'amlse': 1}</field>
	</record>

</odoo>
